<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Restorant Menüsü</title>

    <link rel="icon" type="image/x-icon" href="~/img/other/logo-icon.ico">
        <link href="~/css/style.css" rel="stylesheet" />
        <link href="~/css/rezerve.css" rel="stylesheet" />
        <link href="~/css/sss.css" rel="stylesheet" />
        <link href="~/css/subelerimiz.css" rel="stylesheet" />
    </head>

    <body>
        <!--HAMBURGER  MENU EKKE-->
        <nav class="menu">
            <div class="logo-group">
                <img src="~/img/other/rocket_result.webp" alt="image not find" id="logo-img">
                    <h2 id="logo-title">
                        Roket Restorant
                    </h2>
                </div>

                <ul class="navbar-ul">
                    <li><a asp-controller="Home" asp-action="Index" class="navbar-link">Anasayfa</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="main-course" class="navbar-link">Menü</a></li>
                    <li><a asp-controller="Home" asp-action="subelerimiz" class="navbar-link">Şubelerimiz</a></li>
                    <li><a asp-controller="Home" asp-fragment="footer" class="navbar-link">İletişim</a></li>
                </ul>

                <button id="btn-rezerve">
                    <a asp-controller="Home" asp-action="Rezerve">Rezervasyon Yap</a>
                </button>
            </nav>


            <main>
                <div class="sabit">
                    <a href="#" class="sabit-link">⬆</a>
                </div>


                @RenderBody()
            </main>




            <footer id="footer">
                <div class="footer-bolumler">
                    <div class="footer-bolum maps">
                        <h2>Konumumuz</h2>
                        <iframe class="iframe-maps"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3072.9500502880014!2d27.881607000000002!3d39.628328499999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14b701ccc878a8c5%3A0xa45a8dc60eee9081!2zRW1yZSBCaWxnaXNheWFyIC0gWWF6xLFsxLFtJkRhbsSxxZ9tYW5sxLFr!5e0!3m2!1str!2sus!4v1778440391827!5m2!1str!2sus"
                                width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                        <p class="maps-prg">Yıldız, 3 Evler Sk. No:6-8, 10100
                            Altıeylül/BaIıkesir, Türkiye </p>
                        </div>
                        <div class="footer-bolum links">
                            <h2>Hızlı Erişim</h2>
                            <ul class="hizliErisim">
                                <li class="hizliErisim-link"><a asp-controller="Home" asp-action="index">Menümüz</a></li>
                                <li class="hizliErisim-link"><a asp-controller="Home" asp-action="subelerimiz">Şubelerimiz</a></li>
                                <li class="hizliErisim-link"><a asp-controller="Home" asp-action="sss">Sık Sorulan Sorular</a></li>
                                <li class="hizliErisim-link"><a asp-controller="Home" asp-action="rezerve">Sipariş Ver</a></li>
                            </div>
                            <div class="footer-bolum iletisim">
                                <h2>İletişim</h2>
                                <div class="iletisim-group">
                                    <img alt="image not find" class="iletisim-img" src="~/img/other/phone-icon_result.webp" />
                                    <a class="iletisim-link" href="#">Telefon</a>
                                </div>
                                <div class="iletisim-group">
                                    <img alt="image not find" class="iletisim-img" src="~/img/other/mail-icon_result.webp" />
                                    <a class="iletisim-link" href="#">E-mail</a>
                                </div>
                                <div class="iletisim-group">
                                    <img alt="image not find" class="iletisim-img" src="~/img/other/instagram-icon_result.webp" />
                                    <a class="iletisim-link" href="#">İnstagram</a>
                                </div>
                                <div class="iletisim-group">
                                    <img alt="image not find" class="iletisim-img" src="~/img/other/facebook-icon_result.webp" />
                                    <a class="iletisim-link" href="#">Facebook</a>
                                </div>
                                <div class="iletisim-group">
                                    <img alt="image not find" class="iletisim-img" src="~/img/other/youtube-icon_result.webp" />
                                    <a class="iletisim-link" href="#">Youtube</a>
                                </div>
                            </div>
                        </div>
                        <div class="github-container">
                            <p>Bu Projemi Ve Daha Fazla Projemi İncelemek Ve Desteklemek için Beni <a
                                href="https://github.com/emresoft46" id="github-link" target="_blank">Github</a> dan takip
                                edebilirsiniz </p>
                            </div>
                        </footer>
    
                    </body>



                </html>